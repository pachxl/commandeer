# Dependencies
node_modules/

# Build output
dist/
src-tauri/target/

# Tauri generated
src-tauri/gen/

# Binary build artifacts (not source)
bin/

# Script-command folder: empty by default; the app discovers/populates it at
# runtime (no longer seeded), so keep user scripts out of git.
/scripts/
/commands/

# Env / local config
.env
.env.*

# OS
.DS_Store
Thumbs.db

# Editor
.idea/

# Husky internals (the .husky/_/ wrappers are regenerated by `husky` / prepare)
.husky/_/

# Logs
*.log

# Agent config is shared across systems: .agents/ is the canonical home for
# skills + hooks, and .claude/ + .codex/ wire to it. Only personal/local
# overrides stay out of git.
.claude/settings.local.json
.codex/settings.local.json
