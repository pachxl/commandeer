# Dependencies
node_modules/

# Build output
dist/
src-tauri/target/

# Tauri generated
src-tauri/gen/

# Binary build artifacts (not source)
bin/

# Script-command folder: empty by default; the app discovers/populates it at
# runtime (no longer seeded), so keep user scripts out of git.
/scripts/
/commands/

# Env / local config
.env
.env.*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/

# Logs
*.log

# Share .claude/ (skills, hooks, project settings) across systems;
# keep only personal/local overrides out of git.
.claude/settings.local.json